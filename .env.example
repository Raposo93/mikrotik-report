# Copy to .env on the collecting host and restrict it to the service user.
MIKROTIK_REST_URL=https://router.example.net/rest
MIKROTIK_USER=report-reader
MIKROTIK_PASSWORD=replace-with-private-password
# Optional CA bundle for a private certificate authority; leave unset for system trust.
# MIKROTIK_CA_FILE=/etc/ssl/certs/router-ca.pem

# Match exactly one local IPv4 drop rule and the bouncer's IPv4 drop rules.
MIKROTIK_LOCAL_RULE_TABLE=raw
MIKROTIK_LOCAL_RULE_COMMENT="Drop local detections"
MIKROTIK_LOCAL_LIST=local-detections
MIKROTIK_CROWDSEC_RULE_SIGNATURE=@cs-routeros-bouncer
MIKROTIK_CROWDSEC_LIST=crowdsec-banned

# Dedicated RouterOS memory log buffer and prefix for the local detection rule.
MIKROTIK_DETECTION_LOG_BUFFER=mikrotik-report
MIKROTIK_DETECTION_LOG_PREFIX=mikrotik-report-detect

# Optional source-IP ASN enrichment through Team Cymru bulk WHOIS.
MIKROTIK_ASN_ENABLED=false
# Bound hydration work per collection and periodically refresh successful metadata.
MIKROTIK_ASN_BATCH_SIZE=100
MIKROTIK_ASN_REFRESH_DAYS=30
# Failed lookups retry exponentially between these bounds.
MIKROTIK_ASN_RETRY_BASE_SECONDS=3600
MIKROTIK_ASN_RETRY_MAX_SECONDS=86400

# Persist outside the checkout; the service user needs write access.
MIKROTIK_REPORT_DB=/var/lib/mikrotik-report/report.sqlite3
MIKROTIK_REPORT_TIMEZONE=UTC
MIKROTIK_REPORT_TO=recipient@example.net
# Absolute path to the external mail transport helper.
MIKROTIK_REPORT_NOTIFIER=/usr/local/bin/send-mail
MIKROTIK_REPORT_SUBJECT="MikroTik weekly blocking report"
# Optional subject for the monthly report.
MIKROTIK_MONTHLY_SUBJECT="MikroTik monthly blocking report"
MIKROTIK_REPORT_MAIL_ACCOUNT=notifications
# MIKROTIK_REPORT_FROM=Router report <notifications@example.net>

# Persistent `run` mode intervals. Each workflow also runs once at startup.
MIKROTIK_COLLECT_INTERVAL_SECONDS=300
MIKROTIK_WEEKLY_CHECK_INTERVAL_SECONDS=86400
MIKROTIK_MONTHLY_CHECK_INTERVAL_SECONDS=86400
